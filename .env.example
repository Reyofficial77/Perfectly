# Neon PostgreSQL — copy the pooled connection string from Neon Console → Connect
# Keep this server-side only. Never prefix it with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Set this to your deployed site origin in production, e.g. https://perfectly.vercel.app
# Optional locally; Vercel request headers are used when omitted.
APP_URL=http://localhost:3000

# Google OAuth app credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth app credentials (GitHub Developer Settings)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Ollama Cloud — Beam and Gemma 4
OLLAMA_API_KEY=

# OpenAI Platform API — GPT models
OPENAI_API_KEY=

# Anthropic Claude Console API — Claude models
ANTHROPIC_API_KEY=

# Optional model ID overrides
OLLAMA_BEAM_MODEL=beam
OLLAMA_GEMMA_MODEL=gemma4:31b
OPENAI_GPT_LUNA_MODEL=gpt-6-luna
OPENAI_GPT_ASTRA_MODEL=gpt-6-astra
ANTHROPIC_SONNET_MODEL=claude-sonnet-5-5
ANTHROPIC_OPUS_MODEL=claude-opus-5-5
